<?xml version="1.0" encoding="utf-8"?>

<!-- Transforms applied to Web.config when publishing a Release build. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <system.web>
    <!-- Never ship a debug build: it disables optimisations and leaks more detail in errors. -->
    <compilation xdt:Transform="RemoveAttributes(debug)" />

    <!-- Release is expected to run over HTTPS, so cookies may only travel over it. -->
    <httpCookies requireSSL="true" xdt:Transform="SetAttributes(requireSSL)" />

    <!-- Show Error.aspx to everyone, including requests from the server itself. -->
    <customErrors mode="On" xdt:Transform="SetAttributes(mode)" />
  </system.web>
</configuration>
